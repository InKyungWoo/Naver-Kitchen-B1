# ================================
# 네이버 밴드 → 슬랙 연동 환경변수
# ================================

# ========== 메일 설정 (IMAP) ==========
# 네이버웍스: imap.worksmobile.com
# 네이버메일: imap.naver.com
IMAP_HOST=imap.worksmobile.com
IMAP_USER=your-email@example.com
IMAP_PASS=your-app-password

# ========== 슬랙 설정 ==========
# Incoming Webhook URL
# https://api.slack.com/messaging/webhooks 에서 발급
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# ========== 밴드 URL ==========
BAND_URL=https://band.us/band/YOUR_BAND_ID

# ========== 에러 알림 ==========
ALERT_EMAIL=your-email@example.com

# ========== 참고 ==========
# 1. 밴드에서 메일 알림 설정 필요 (밴드 설정 > 알림 > 이메일 알림 켜기)
# 2. 네이버웍스/네이버메일에서 IMAP 사용 설정 필요
# 3. 앱 비밀번호 사용 권장 (2단계 인증 사용 시)
