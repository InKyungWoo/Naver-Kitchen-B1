# ================================
# 네이버 밴드 → 슬랙 연동 환경변수
# ================================

# ========== 메일 설정 (IMAP) ==========
# 네이버웍스: imap.worksmobile.com
# 네이버메일: imap.naver.com
IMAP_HOST=imap.worksmobile.com
IMAP_USER=your_email@your_domain.com
IMAP_PASS=your_email_password_or_app_password

# ========== 밴드 로그인 (로컬 전용) ==========
# login.js 실행용 (휴대폰 번호 로그인)
BAND_PHONE=01012345678
BAND_PW=your_band_password

# ========== 밴드 쿠키 (Vercel 환경변수) ==========
# login.js 실행 후 생성됨 (Base64 인코딩)
BAND_COOKIES=

# ========== 슬랙 설정 ==========
# Incoming Webhook URL
# https://api.slack.com/messaging/webhooks 에서 발급
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ========== 참고 ==========
# 1. 밴드에서 메일 알림 설정 필요 (밴드 설정 > 알림 > 이메일 알림 켜기)
# 2. 네이버웍스/네이버메일에서 IMAP 사용 설정 필요
# 3. 앱 비밀번호 사용 권장 (2단계 인증 사용 시)
